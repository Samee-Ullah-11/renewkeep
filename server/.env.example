# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas free tier connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/renewkeep

# JWT (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Gmail SMTP (use a Gmail "app password", not your real password)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password

# Shared secret for POST /api/internal/run-reminders (any long random string).
# Leave unset to disable the endpoint entirely.
INTERNAL_SECRET=change-me-too


# File storage: "disk" (default) or "cloudinary" in production
STORAGE_DRIVER=disk
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
